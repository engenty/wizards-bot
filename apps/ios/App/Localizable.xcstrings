    "Your Bot Server reads the files on its computer, in place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Bot Server liest die Dateien auf seinem Computer, dort wo sie liegen."
          }
        }
      }
    },
    "“%@”\n\nThe model on this phone reads your calendar, reminders, contacts and the folders connected here to answer. Only the answer goes to %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“\n\nDas Modell auf diesem Telefon liest dafür deinen Kalender, deine Erinnerungen, Kontakte und die hier verbundenen Ordner. Nur die Antwort geht an %2$@."
          }
        }
      }
    },
    "Let %@ do “%@”?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darf %1$@ „%2$@“ ausführen?"
          }
        }
      }
    },
    "Don't allow" : {
      "localizations" : {
