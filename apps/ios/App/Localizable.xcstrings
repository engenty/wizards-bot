    "Address" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresse"
          }
        }
      }
    },
    "Access token, if it needs one" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugangstoken, falls er einen braucht"
          }
        }
      }
    },
    "The service is used by the model on this %@ only. The token stays in this %@’s Keychain; your Bot Server learns only the name. A tool that changes something asks you here first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den Dienst nutzt nur das Modell auf diesem %1$@. Der Token bleibt im Schlüsselbund dieses %2$@; dein Bot Server erfährt nur den Namen. Ein Werkzeug, das etwas ändert, fragt dich hier vorher."
          }
        }
      }
    },
    "Sign in a service" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Dienst anmelden"
          }
        }
      }
    },
    "This is not an address. It starts with https://." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist keine Adresse. Sie beginnt mit https://."
          }
