    },
    "iCloud Drive, On My %@ or another place in Files. The files stay here: your agents ask this %@, and only the answer goes to your Bot Server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud Drive, Auf meinem %1$@ oder ein anderer Ort in Dateien. Die Dateien bleiben hier: Deine Agenten fragen dieses %2$@, und nur die Antwort geht an deinen Bot Server."
          }
        }
      }
    },
    "Its model reads your calendar, reminders, contacts and the folders here, and sends back only the answer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Modell liest deinen Kalender, deine Erinnerungen, Kontakte und die Ordner hier und schickt nur die Antwort zurück."
