      }
    },
    "Sign out %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ abmelden"
          }
        }
      }
    },
    "You read it and send it. The app sends nothing by itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du liest sie und schickst sie ab. Die App schickt nichts von selbst."
