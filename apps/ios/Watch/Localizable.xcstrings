{
  "sourceLanguage" : "en",
  "strings" : {
    "Answer on your phone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem iPhone beantworten"
          }
        }
      }
    },
    "Connect your phone to your Bot Server first. This watch follows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde zuerst dein iPhone mit deinem Bot Server. Diese Uhr folgt."
          }
        }
      }
    },
    "Needs you" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht dich"
          }
        }
      }
    },
    "Open wizards.bot on your iPhone and allow where your messages go." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne wizards.bot auf deinem iPhone und erlaube, wohin deine Nachrichten gehen."
          }
        }
      }
    },
    "Open wizards.bot on your phone. It connects this watch to your Bot Server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
