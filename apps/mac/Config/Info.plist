<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>bot.wizards.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wizardsbot</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>SUFeedURL</key>
	<string>https://github.com/engenty/wizards-bot/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_KEY)</string>
	<key>SUEnableInstallerLauncherService</key>
	<false/>
	<key>SUScheduledCheckInterval</key>
	<integer>21600</integer>
	<key>NSLocalNetworkUsageDescription</key>
	<string>The app reaches your Bot Server on this network.</string>
</dict>
</plist>
