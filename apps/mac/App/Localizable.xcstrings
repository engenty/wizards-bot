    "Connected to %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden mit %@"
          }
        }
      }
    },
    "Connecting to %@…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindet mit %@ …"
          }
        }
