          }
        }
      }
    },
    "Save…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern …"
          }
        }
      }
    },
    "Scan it with the camera of your iPhone, or type the address and the code into the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne ihn mit der Kamera deines iPhones, oder tippe Adresse und Code in die App."
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen …"
          }
        }
      }
    },
