{
  "sourceLanguage": "en",
  "strings": {
    "%@ removed this Mac. Offer the models again with a new code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat diesen Mac entfernt. Biete die Modelle mit einem neuen Code wieder an."
          }
        }
      }
    },
    "A Bot Server already runs on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac läuft schon ein Bot Server."
          }
        }
      }
    },
    "A Bot Server is installed on this Mac, but it does not run.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac ist ein Bot Server installiert, aber er läuft nicht."
          }
        }
      }
    },
    "A Bot Server listens on %@. Quit that program to start one here, or connect to a Bot Server elsewhere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bot Server hört auf %@. Beende dieses Programm, um hier einen zu starten, oder verbinde dich mit einem Bot Server woanders."
          }
        }
      }
    },
    "A Bot Server on another computer or at wizards.bot then uses Claude Code, Codex and Ollama of this Mac while it is on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bot Server auf einem anderen Computer oder auf wizards.bot verwendet dann Claude Code, Codex und Ollama dieses Macs, solange er läuft."
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse"
          }
        }
      }
    },
    "All of your Bot Server in one file: agents, conversations, files, keys. It is encrypted with a passphrase you choose; keep it apart from the file. Without it nobody can read the file, you neither.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein ganzer Bot Server in einer Datei: Wizards, Gespräche, Dateien, Schlüssel. Sie ist mit einer Passphrase verschlüsselt, die du wählst; bewahre sie getrennt von der Datei auf. Ohne sie kann niemand die Datei lesen, auch du nicht."
          }
        }
      }
    },
    "Allowed to run in the background": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darf im Hintergrund laufen"
          }
        }
      }
    },
    "Allowing it to run in the background": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubnis, im Hintergrund zu laufen"
          }
        }
      }
    },
    "An older Bot Server runs on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Mac läuft ein älterer Bot Server."
          }
        }
      }
    },
    "At least %lld characters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens %lld Zeichen."
          }
        }
      }
    },
    "At wizards.bot, on another computer, or your own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf wizards.bot, auf einem anderen Computer oder auf deinem eigenen."
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück"
          }
        }
      }
    },
