      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passphrase"
          }
        }
      }
    },
    "Port %@ is taken by %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Port %@ ist von %@ belegt."
          }
        }
      }
    },
    "Port %@ is taken by %@. The app starts no Bot Server beside it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Port %@ ist von %@ belegt. Die App startet keinen Bot Server daneben."
          }
        }
      }
    },
    "Prefer the terminal? ": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lieber im Terminal? "
          }
        }
      }
    },
    "Quit wizards.bot": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "wizards.bot beenden"
          }
        }
      }
    },
    "Remove from this Mac…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von diesem Mac entfernen …"
          }
        }
      }
    },
    "Remove the Bot Server from this Mac?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot Server von diesem Mac entfernen?"
          }
        }
      }
    },
    "Remove, keep the data": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen, Daten behalten"
          }
        }
      }
    },
    "Remove, move the data to the Trash": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen, Daten in den Papierkorb"
          }
        }
      }
    },
    "Save a backup": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherung speichern"
          }
        }
      }
    },
