{
  "name": "wizards-bot",
  "private": true,
  "license": "MIT",
  "version": "0.1.3",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "wizards-bot": "node apps/home/src/cli.ts",
    "start": "node apps/home/src/cli.ts start",
    "dev": "node --watch apps/home/src/cli.ts start",
    "dev:web": "pnpm --filter @wizards-bot/web dev",
    "build": "pnpm --filter @wizards-bot/web build",
    "fix": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "release": "node scripts/release.mjs",
    "release:changelog": "node scripts/release.mjs --changelog",
    "release:tag": "node scripts/release.mjs --tag",
    "pack:home": "node scripts/pack.mjs",
    "pack:mac": "node scripts/pack-mac.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "git-cliff": "^2.14.2"
  }
}
